<mxfile host="app.diagrams.net" agent="Claude Code" version="24.0.0">
  <diagram id="cqrs-backend" name="CQRS Backend por Módulo">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Backend NestJS — CQRS por Módulo" style="text;html=1;fontSize=20;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="10" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- ITEMS MODULE -->
        <mxCell id="items" value="ITEMS MODULE (Reads)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="items-body" value="Query: GetItemsQuery&#10;Handler: GetItemsHandler → SELECT items (filtros: search ILIKE, type, minPrice, maxPrice, sortBy)&#10;Controller: GET /items?search=&amp;type=&amp;minPrice=&amp;maxPrice=&amp;sortBy=&#10;Entity: Item (id, name, description, price, type, category, active, createdAt, updatedAt)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="90" width="480" height="100" as="geometry" />
        </mxCell>

        <!-- SESSION MODULE -->
        <mxCell id="session" value="SESSION MODULE (Stateless JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="60" width="500" height="140" as="geometry" />
        </mxCell>
        <mxCell id="session-body" value="Controller: POST /session/start → firma JWT anónimo (sin auth de usuario)&#10;Guard: SessionGuard → valida Bearer token en rutas protegidas&#10;Duración: 3 minutos (exp real, corregido 2026-09-16)&#10;Sin base de datos — validación JWT pura" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="90" width="480" height="100" as="geometry" />
        </mxCell>

        <!-- REGISTRATIONS MODULE -->
        <mxCell id="reg" value="REGISTRATIONS MODULE (Reads + Writes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="1060" height="230" as="geometry" />
        </mxCell>
        <mxCell id="reg-cmd" value="Command: CreateRegistrationCommand&#10;Handler: CreateRegistrationHandler&#10;  1. Validar: email único (409), fecha futura (400), items existen (404), min 1 ítem&#10;  2. Llamar DiscountCalculatorService.calculateDiscounts()&#10;  3. INSERT Registration + RegistrationItem[] (price snapshot)&#10;  4. Emit RegistrationConfirmedEvent&#10;&#10;Controller: POST /registrations ← SessionGuard (Bearer token)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="260" width="500" height="180" as="geometry" />
        </mxCell>
        <mxCell id="reg-qry" value="Query: GetRegistrationByIdQuery&#10;Handler: GetRegistrationByIdHandler → SELECT con relations (items)&#10;&#10;Controller: GET /registrations/:id&#10;&#10;Entities:&#10;  Registration (id, firstName, lastName, email, eventDateTime,&#10;    servicesDiscountPct, productsDiscountPct, createdAt, items:FK)&#10;  RegistrationItem (id, registrationId:FK, itemId, itemType, priceSnapshot)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="575" y="260" width="500" height="180" as="geometry" />
        </mxCell>

        <!-- COMMON SERVICES -->
        <mxCell id="common" value="COMMON SERVICES (Domain Logic)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="490" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="common-body" value="DiscountCalculatorService (pura, sin deps de NestJS)&#10;calculateDiscounts(items: SelectedItem[])&#10;→ { servicesDiscountPct, productsDiscountPct }&#10;&#10;Reglas (independientes, no se suman):&#10;· Servicios: ≥2 → 3% · ≥2 y suma&gt;Q.1,500 → 5% (reemplaza 3%)&#10;· Productos: ≥3 → 3% · ≥5 → 5% (reemplaza 3%)" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="520" width="480" height="90" as="geometry" />
        </mxCell>

        <!-- CROSS CUTTING -->
        <mxCell id="cross" value="CROSS-CUTTING CONCERNS (Global)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="600" y="490" width="500" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cross-body" value="ValidationPipe: whitelist de DTOs, rechaza campos desconocidos&#10;HttpExceptionFilter: normaliza respuestas de error&#10;LoggingInterceptor: loguea requests/responses con duración" style="text;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="525" width="480" height="80" as="geometry" />
        </mxCell>

        <!-- Relations -->
        <mxCell id="e1" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="reg" target="common">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="protegido por" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="reg" target="session">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="850" y="220" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
